vector<vector<int>>ans;
bool dfs(int i,int j,vector<vector<int>>&futureMoves,vector<vector<int>>&arr){
  if(arr[i][j]==64){ans = arr;return 1;}
  priority_queue<pair<int,pair<int,int>>,vector<pair<int,pair<int,int>>>,greater<pair<int,pair<int,int>>>>pq;
  for(int it=0;it<8;++it){
    int X = dx[it]+i,Y =dy[it]+j;
    if(X>=0 && X<8 && Y>=0 && Y<8 && arr[X][Y]==0){
      pq.push({futureMoves[X][Y],{X,Y}});
    }
  }
  while(!pq.empty()){
    auto head = pq.top();pq.pop();
    int x = head.second.first,y = head.second.second;
    arr[x][y] = arr[i][j]+1;
    if(dfs(x,y,futureMoves,arr)){
      return 1;
    }
    arr[x][y] = 0;
  }
  return 0;
}

void solve(){
  int n,m;cin>>n>>m;
  vector<vector<int>>futureMoves(8,vector<int>(8,0)),grid(8,vector<int>(8,0));
  grid[m-1][n-1]=1;
  for(int i=0;i<8;++i){
    for(int j=0;j<8;++j){
      for(int it=0;it<8;++it){
        int X = dx[it]+i,Y=dy[it]+j;
        if(X>=0 && X<8 && Y>=0 && Y<8){futureMoves[i][j]++;}
      }
    }
  }
  dfs(m-1,n-1,futureMoves,grid);
  for(auto x:ans){
    for(auto y:x){cout<<y<<" ";}
    cout<<"\n";
  }
  return ;
}
 
 
