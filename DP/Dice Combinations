vector<int>dp;
int f(int target){
  if(target==0){return 1;}
  if(dp[target]!=-1){return dp[target];}
  ll ans =0;
  for(int i=1;i<=6;++i){
    if(i<=target){
      ans = (ans + f(target-i))%mod;
    }
  }
  return dp[target] = ans;
}

void solve() {
  int n;cin>>n;
  dp.resize(n+1,-1);
  cout<<f(n)<<"\n";
  return ;
}
 
 
